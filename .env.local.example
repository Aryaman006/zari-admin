# ─────────────────────────────────────────────────────────────────────────────
# ZARI & JASI ADMIN FRONTEND — Environment Variables Example
# Copy this file to admin-frontend/.env.local and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# URL of the backend API (localhost for dev, Render URL for production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase URL (required to configure remote image pattern loaders for catalog)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co

# Branding metadata
NEXT_PUBLIC_APP_NAME="Zari & Jasi Admin"
